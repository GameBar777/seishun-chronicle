# All optional. Leave empty = ads & analytics fully disabled (default).
# Never commit real values; set them in Cloudflare Pages > Settings > Environment variables.
VITE_ADS_PROVIDER=        # "h5" to enable Google H5 Games Ads (Ad Placement API). Requires approved AdSense + H5 Games Ads access.
VITE_ADSENSE_CLIENT=      # ca-pub-XXXXXXXXXXXXXXXX (your publisher ID; public value but keep it out of the repo)
VITE_ADS_TEST=            # "1" adds data-adbreak-test="on" (mock ads). Remove before production.
VITE_ANALYTICS_ENDPOINT=  # optional POST endpoint; analytics is no-op unless set AND player opts in
